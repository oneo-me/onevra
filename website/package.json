{
  "name": "website",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun --conditions=development node_modules/@react-router/dev/bin.cjs dev",
    "build": "react-router build && bun scripts/prepare-pages.mjs",
    "preview": "bun scripts/preview-pages.mjs",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "check": "bun scripts/check-docs.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fumadocs/base-ui": "^16.17.8",
    "@fumadocs/language": "^0.2.16",
    "@react-router/node": "8.5.0",
    "cn": "^0.5.0",
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^15.4.10",
    "isbot": "^5",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.0",
    "@tailwindcss/vite": "^4",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "estree-util-value-to-estree": "^3.5.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "unist-util-visit": "^5.2.0",
    "vite": "^8"
  }
}
